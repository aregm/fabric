{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fabric Calendar",
  "version": "0.1.0",
  "identifier": "ai.paracels.fabric.calendar",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fabric Calendar",
        "width": 960,
        "height": 760,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/fabric-broker"],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-"
    }
  }
}
