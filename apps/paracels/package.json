  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint src server scripts",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\" \"server/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "chat:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/chat-setup.ts",
    "chat:socket": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server/chat-socket.ts",
    "chat:log": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/chat-log.ts",
    "chat:reset": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/chat-reset.ts"
  },
  "private": true
